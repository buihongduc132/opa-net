#!/bin/bash
# .opa-gate-shim — universal shell gate dispatch shim
# Zero-dep, boot-safe, fail-open on engine error.
# Rulings: ALL shells, ALL binaries, ALL users (incl. root).
# Only minted unlock-keys override.

set -o pipefail 2>/dev/null || true

NAME="${0##*/}"

# 1. Boot safety / recursion guard
self_real=$(readlink -f "$0" 2>/dev/null || true)
if [ "${OPA_GATE_INTERNAL:-0}" = "1" ]; then
  for dir in /usr/local/bin /usr/bin /bin /usr/local/sbin /usr/sbin /sbin; do
    if [ "$dir" != "/opt/opa-gate/bin" ] && [ -x "$dir/$NAME" ]; then
      cand_real=$(readlink -f "$dir/$NAME" 2>/dev/null || true)
      if [ -n "$cand_real" ] && [ -n "$self_real" ] && [ "$cand_real" = "$self_real" ]; then
        continue
      fi
      exec "$dir/$NAME" "$@"
    fi
  done
  echo "opa-gate: $NAME: command not found" >&2
  exit 127
fi

ORIG_PATH="$PATH"
export PATH="/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin"
export OPA_GATE_INTERNAL=1

# 2. Resolve the REAL binary via fixed path table (NEVER re-searching PATH)
REAL_BIN=""
for dir in /usr/local/bin /usr/bin /bin /usr/local/sbin /usr/sbin /sbin; do
  if [ -x "$dir/$NAME" ]; then
    cand_real=$(readlink -f "$dir/$NAME" 2>/dev/null || true)
    if [ -n "$cand_real" ] && [ -n "$self_real" ] && [ "$cand_real" = "$self_real" ]; then
      continue
    fi
    REAL_BIN="$dir/$NAME"
    break
  fi
done

if [ -z "$REAL_BIN" ]; then
  echo "bash: $NAME: command not found" >&2
  exit 127
fi

# 3. Fast-path check: internal and exempt binaries (sudo recursion prevention)
if [ "$NAME" = "sudo" ] || [ "$NAME" = "pi-opa-net" ] || [ "$NAME" = "opa" ] || [ "$NAME" = "bun" ]; then
  PATH="$ORIG_PATH"
  unset OPA_GATE_INTERNAL
  exec "$REAL_BIN" "$@"
fi

# 4. Fast-path allowlist for non-gated & read-only patterns (P2 perf gate: <100ms median)
IS_GATED=1
case "$NAME" in
  git|docker|docker-compose|gh|glab|gcloud|bq|aws|tmux|pkill|killall|herdr|pulumi|rm|bd|pm2|systemctl|terragrunt|nomad|consul|vault|dd|find|du|rg|fd|rgrep|grep|egrep|ls|eza|fsck|baobab)
    IS_GATED=1
    ;;
  *)
    # Non-gated binary (e.g. cat, head, tail, whoami, date, uname, sleep, true, id, sed, awk...)
    IS_GATED=0
    ;;
esac

if [ "$NAME" = "ls" ] || [ "$NAME" = "eza" ]; then
  IS_GATED=0
  for a in "$@"; do
    if [ "$a" = "-R" ] || [ "$a" = "--recursive" ] || [[ "$a" =~ ^-[a-zA-Z0-9]*R ]]; then
      IS_GATED=1
      break
    fi
  done
fi

if [ "$NAME" = "grep" ] || [ "$NAME" = "egrep" ]; then
  IS_GATED=0
  for a in "$@"; do
    if [ "$a" = "-r" ] || [ "$a" = "-R" ] || [ "$a" = "--recursive" ] || [[ "$a" =~ hermes ]]; then
      IS_GATED=1
      break
    fi
  done
fi

if [ "$NAME" = "git" ]; then
  case "${1:-}" in
    status|log|diff|show|rev-parse|version|--version|cat-file|ls-files|ls-remote|describe|blame|shortlog)
      IS_GATED=0
      ;;
  esac
fi

if [ "$IS_GATED" -eq 0 ]; then
  # Still audit-logged per P2 requirement
  AUDIT_LOG="/var/log/opa-gate/audit.jsonl"
  if [ -d "/var/log/opa-gate" ]; then
    if [ ! -f "$AUDIT_LOG" ]; then
      (umask 027 && touch "$AUDIT_LOG" 2>/dev/null && chmod 640 "$AUDIT_LOG" 2>/dev/null && chown root:root "$AUDIT_LOG" 2>/dev/null) || true
    fi
    if [ -w "$AUDIT_LOG" ]; then
      { printf '{"schema_version":"1.0","decision":"allow","action":"allow","source":"fast-path","summary":"fast-path: %s","input":{"raw":"%s","program":"%s"}}\n' "$NAME" "$NAME $*" "$NAME" >> "$AUDIT_LOG"; } 2>/dev/null || true
    elif [ -x "/opt/opa-gate/scripts/opa-gate-audit-append" ]; then
      { printf '{"schema_version":"1.0","decision":"allow","action":"allow","source":"fast-path","summary":"fast-path: %s","input":{"raw":"%s","program":"%s"}}\n' "$NAME" "$NAME $*" "$NAME" | sudo -n /opt/opa-gate/scripts/opa-gate-audit-append 2>/dev/null; } 2>/dev/null || true
    else
      { printf '{"schema_version":"1.0","decision":"allow","action":"allow","source":"fast-path","summary":"fast-path: %s","input":{"raw":"%s","program":"%s"}}\n' "$NAME" "$NAME $*" "$NAME" >> "$AUDIT_LOG"; } 2>/dev/null || true
    fi
  fi
  PATH="$ORIG_PATH"
  unset OPA_GATE_INTERNAL
  exec "$REAL_BIN" "$@"
fi

# 5. Engine CLI resolution
ENGINE_CLI=""
if [ -x "/opt/opa-gate/engine/bin/pi-opa-net" ]; then
  ENGINE_CLI="/opt/opa-gate/engine/bin/pi-opa-net"
elif [ -x "/usr/local/bin/pi-opa-net" ]; then
  ENGINE_CLI="/usr/local/bin/pi-opa-net"
elif command -v pi-opa-net >/dev/null 2>&1; then
  ENGINE_CLI="$(command -v pi-opa-net)"
fi

# Fail-open if engine is missing or unexecutable
if [ -z "$ENGINE_CLI" ]; then
  PATH="$ORIG_PATH"
  unset OPA_GATE_INTERNAL
  exec "$REAL_BIN" "$@"
fi

# 5. Format command for evaluation
CMD_STR=$(printf '%q ' "$NAME" "$@")

# 6. Unlock-key seam (ruling / P1): pass through OPA_UNLOCK* / --unlock
UNLOCK_ARGS=()
if [ -n "$OPA_UNLOCK_KEY" ]; then
  UNLOCK_ARGS+=(--unlock "$OPA_UNLOCK_KEY")
fi
if [ -n "$OPA_UNLOCK_KEYS" ]; then
  IFS=',' read -ra ADDR <<< "$OPA_UNLOCK_KEYS"
  for k in "${ADDR[@]}"; do
    [ -n "$k" ] && UNLOCK_ARGS+=(--unlock "$k")
  done
fi
if [ -n "$PIOPANET_UNLOCK_KEYS" ]; then
  IFS=',' read -ra ADDR <<< "$PIOPANET_UNLOCK_KEYS"
  for k in "${ADDR[@]}"; do
    [ -n "$k" ] && UNLOCK_ARGS+=(--unlock "$k")
  done
fi

# 7. Evaluate command with hard timeout (500ms boot-safety requirement)
AUDIT_LOG="/var/log/opa-gate/audit.jsonl"
EVAL_OUT=""
EVAL_EXIT=0

TIMEOUT_BIN=""
for t in /usr/bin/timeout /bin/timeout; do
  if [ -x "$t" ]; then
    TIMEOUT_BIN="$t"
    break
  fi
done

if [ -n "$TIMEOUT_BIN" ]; then
  EVAL_OUT=$("$TIMEOUT_BIN" 0.5s "$ENGINE_CLI" eval "$CMD_STR" --json "${UNLOCK_ARGS[@]}" 2>/dev/null)
  EVAL_EXIT=$?
else
  EVAL_OUT=$("$ENGINE_CLI" eval "$CMD_STR" --json "${UNLOCK_ARGS[@]}" 2>/dev/null)
  EVAL_EXIT=$?
fi

# 8. Audit logging (LD-Y2): append decision JSONL if non-empty
if [ -n "$EVAL_OUT" ] && [ -d "/var/log/opa-gate" ]; then
  if [ ! -f "$AUDIT_LOG" ]; then
    (umask 027 && touch "$AUDIT_LOG" 2>/dev/null && chmod 640 "$AUDIT_LOG" 2>/dev/null && chown root:root "$AUDIT_LOG" 2>/dev/null) || true
  fi
  if [ -w "$AUDIT_LOG" ]; then
    { printf '%s\n' "$EVAL_OUT" >> "$AUDIT_LOG"; } 2>/dev/null || true
  elif [ -x "/opt/opa-gate/scripts/opa-gate-audit-append" ]; then
    { printf '%s\n' "$EVAL_OUT" | sudo -n /opt/opa-gate/scripts/opa-gate-audit-append 2>/dev/null; } 2>/dev/null || true
  else
    { printf '%s\n' "$EVAL_OUT" >> "$AUDIT_LOG"; } 2>/dev/null || true
  fi
fi

# 9. Handle Decision
if [ "$EVAL_EXIT" -eq 2 ]; then
  SUMMARY=""
  if [[ "$EVAL_OUT" =~ \"summary\":\"([^\"]+)\" ]]; then
    SUMMARY="${BASH_REMATCH[1]}"
  fi
  if [ -z "$SUMMARY" ]; then
    SUMMARY="BLOCKED by opa-gate: $NAME $*"
  fi
  echo "$SUMMARY" >&2
  exit 2
fi

# Exit 0 (allow) or timeout/failure (fail-open)
PATH="$ORIG_PATH"
unset OPA_GATE_INTERNAL
exec "$REAL_BIN" "$@"
