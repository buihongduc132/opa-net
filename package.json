{
  "name": "pi-opa-net",
  "version": "0.1.0",
  "description": "OPA-backed bash command guard with structured --json output (decision-output.v1 schema). Fail-open default, agent-agnostic, exit-code compatible with Claude Code hook protocol.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pi-opa-net": "bin/pi-opa-net.js"
  },
  "files": [
    "dist",
    "bin",
    "schemas",
    "policy"
  ],
  "scripts": {
    "build": "bun run clean && bun build src/index.ts --outdir dist --target bun",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write src tests",
    "lint:ci": "biome ci src tests",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "check": "bun run typecheck && bun run lint:ci && bun test --coverage",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "opa",
    "rego",
    "bash-guard",
    "safety-net",
    "claude-code",
    "pi",
    "policy"
  ],
  "license": "MIT",
  "author": "buihongduc132",
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "shell-quote": "^1.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "@types/shell-quote": "^1.7.5",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
